NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Gerçek ödeme akışını etkinleştirmek için sunucu tarafında doldurun.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Anonim istek rate-limit anahtarlarını geri döndürülemez biçimde özetlemek için uzun, rastgele bir sunucu sırrı.
RATE_LIMIT_SECRET=
# İşlem e-postalarını etkinleştirmek için Resend anahtarı ve doğrulanmış gönderici adresi.
RESEND_API_KEY=
EMAIL_FROM="Taskavia <bildirim@your-domain.example>"
# Yönetici paneline erişebilecek e-posta adresleri (virgülle ayrılmış).
ADMIN_EMAILS=admin@your-domain.example
# Yalnızca ayrı test Supabase projesinde E2E çalıştırırken açıkça ayarlayın.
TASKAVIA_E2E_ALLOW_REMOTE_WRITE=false
TASKAVIA_E2E_PROJECT_REF=
